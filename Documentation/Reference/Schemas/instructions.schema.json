{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Instruction report definitions, version 2",
  "$defs": {
    "section": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "source",
        "path",
        "hash"
      ]
    },
    "changes": {
      "type": "object",
      "properties": {
        "changed": {
          "type": "boolean"
        },
        "lockMissing": {
          "type": "boolean"
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "before": {
                "$ref": "#/$defs/section"
              },
              "after": {
                "$ref": "#/$defs/section"
              }
            },
            "required": []
          }
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "target": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "changed": {
                "type": "boolean"
              },
              "agentsChanged": {
                "type": "boolean"
              },
              "beforeAgents": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              },
              "afterAgents": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "before": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "file"
                  },
                  "base64": {
                    "type": "string",
                    "contentEncoding": "base64"
                  }
                },
                "required": [
                  "kind",
                  "base64"
                ]
              },
              "after": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "file"
                  },
                  "base64": {
                    "type": "string",
                    "contentEncoding": "base64"
                  }
                },
                "required": [
                  "kind",
                  "base64"
                ]
              },
              "drift": {
                "enum": [
                  "clean",
                  "drifted",
                  "missing"
                ]
              },
              "foreign": {
                "type": "boolean"
              }
            },
            "required": [
              "target",
              "path",
              "changed",
              "agentsChanged",
              "beforeAgents",
              "afterAgents",
              "foreign"
            ]
          }
        },
        "changedPrompts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "changed",
        "lockMissing",
        "sections",
        "targets",
        "changedPrompts"
      ]
    }
  }
}
