{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill and instruction update preview, version 2",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "scope": {
      "enum": [
        "project",
        "user"
      ]
    },
    "changed": {
      "type": "boolean"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "changed": {
            "type": "boolean"
          },
          "oldRevision": {
            "type": "string"
          },
          "newRevision": {
            "type": "string"
          },
          "oldHash": {
            "type": "string"
          },
          "newHash": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "before": {
                  "$ref": "#/$defs/entry"
                },
                "after": {
                  "$ref": "#/$defs/entry"
                }
              },
              "required": [
                "path"
              ]
            }
          },
          "oldVersion": {
            "type": "string"
          },
          "newVersion": {
            "type": "string"
          },
          "lockMissing": {
            "type": "boolean"
          },
          "membership": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "agent": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "before": {
                  "$ref": "#/$defs/membership"
                },
                "after": {
                  "$ref": "#/$defs/membership"
                }
              },
              "required": [
                "agent",
                "path",
                "before",
                "after"
              ]
            }
          }
        },
        "required": [
          "name",
          "source",
          "changed",
          "files"
        ]
      }
    },
    "instructions": {
      "$ref": "instructions.schema.json#/$defs/changes"
    },
    "lockMissing": {
      "type": "boolean",
      "description": "Combined preview: no resolved state existed when preparation began."
    }
  },
  "required": [
    "schemaVersion",
    "scope",
    "changed",
    "skills"
  ],
  "$defs": {
    "entry": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "file"
            },
            "base64": {
              "type": "string",
              "contentEncoding": "base64"
            },
            "executable": {
              "type": "boolean",
              "description": "Whether any execute bit is set; not full POSIX permissions."
            }
          },
          "required": [
            "kind",
            "base64"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "directory"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "symlink"
            },
            "destination": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "destination"
          ]
        }
      ]
    },
    "membership": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "absent"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "installed"
            },
            "mode": {
              "enum": [
                "link",
                "copy",
                "edit"
              ]
            }
          },
          "required": [
            "kind",
            "mode"
          ]
        }
      ]
    }
  }
}
