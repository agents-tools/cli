{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Instruction export, version 1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope": {
            "enum": [
              "project",
              "user"
            ]
          },
          "root": {
            "type": "string"
          },
          "status": {
            "enum": [
              "locked",
              "missingLock",
              "pendingRecovery",
              "unavailable"
            ]
          },
          "message": {
            "type": "string"
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "target": {
                  "type": "string"
                },
                "agents": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "import": {
                  "type": "string"
                },
                "sections": {
                  "type": "array",
                  "items": {
                    "$ref": "instructions.schema.json#/$defs/section"
                  }
                }
              },
              "required": [
                "target",
                "agents",
                "sections"
              ]
            }
          },
          "unplaced": {
            "type": "array",
            "items": {
              "$ref": "instructions.schema.json#/$defs/section"
            }
          },
          "prompts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "sections": {
                  "type": "array",
                  "items": {
                    "$ref": "instructions.schema.json#/$defs/section"
                  }
                }
              },
              "required": [
                "name",
                "sections"
              ]
            }
          }
        },
        "required": [
          "scope",
          "root",
          "status",
          "targets",
          "unplaced",
          "prompts"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "scopes"
  ]
}
