{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill and instruction diagnosis, version 1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "ok": {
      "type": "boolean"
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "root": {
            "type": "string"
          },
          "scope": {
            "enum": [
              "project",
              "user"
            ]
          },
          "ok": {
            "type": "boolean"
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Core diagnostic ID. Pending recovery and unresolved transaction IDs are reported as errors; unresolved transaction messages retain owner-action details."
                },
                "status": {
                  "enum": [
                    "ok",
                    "warning",
                    "error"
                  ]
                },
                "message": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "skills",
                    "instructions"
                  ]
                }
              },
              "required": [
                "id",
                "status",
                "message"
              ]
            }
          }
        },
        "required": [
          "root",
          "scope",
          "ok",
          "checks"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "ok",
    "roots"
  ]
}
